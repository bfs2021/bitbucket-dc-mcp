{
  "name": "@shibainu16/bitbucket-dc-mcp",
  "version": "1.4.0",
  "description": "HTTP MCP server for Bitbucket Data Center REST API",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && chmod 755 build/index.js",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node build/index.js",
    "inspect:http": "npm run build && npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
    "serve:stdio": "npm run build && MCP_TRANSPORT=stdio node build/index.js",
    "serve:http": "npm run build && MCP_TRANSPORT=http PORT=3000 node build/index.js"
  },
  "keywords": [
    "mcp",
    "bitbucket",
    "bitbucket-datacenter",
    "model-context-protocol"
  ],
  "author": "lvluu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvluu/bitbucket-dc-mcp.git"
  },
  "homepage": "https://github.com/lvluu/bitbucket-dc-mcp#readme",
  "bugs": {
    "url": "https://github.com/lvluu/bitbucket-dc-mcp/issues"
  },
  "imports": {
    "#lib/*.js": "./build/lib/*.js",
    "#registry/*.js": "./build/registry/*.js",
    "#server/*.js": "./build/server/*.js",
    "#tools/*.js": "./build/tools/*.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "axios": "^1.13.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "bin": {
    "bitbucket-dc-mcp": "./build/index.js"
  },
  "files": [
    "build",
    "!build/**/*.test.*",
    "README.md",
    "LICENSE"
  ]
}
